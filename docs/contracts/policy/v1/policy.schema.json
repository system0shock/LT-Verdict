{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LT Verdict policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "rules"],
  "properties": {
    "schema_version": {
      "const": "policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_floor": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "min_samples": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_missing_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "max_gap_cells": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "missing_transaction": { "enum": ["no_verdict", "warn"] }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "platform_services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "platform_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal"],
      "properties": {
        "signal": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "platform_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/platform_rule" }
    }
  },
  "$defs": {
    "window_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "operator", "threshold", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "metric": {
          "enum": [
            "response_time_p95_ms",
            "response_time_p99_ms",
            "error_rate_ratio",
            "throughput_rps"
          ]
        },
        "operator": {
          "enum": ["lte", "gte"]
        },
        "threshold": {
          "type": "number"
        },
        "min_samples": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "window_ids": { "$ref": "#/$defs/window_ids" },
        "scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/overall_scope"
            },
            {
              "$ref": "#/$defs/transaction_scope"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "metric": {
              "const": "response_time_p95_ms"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "response_time_p99_ms"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "error_rate_ratio"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "throughput_rps"
            },
            "min_samples": false,
            "operator": {
              "const": "gte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        }
      ]
    },
    "platform_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal", "scope", "operator", "threshold", "unit", "aggregation", "min_consecutive_cells", "effect"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signal": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scope": {
          "oneOf": [{ "$ref": "#/$defs/service_scope" }, { "$ref": "#/$defs/all_services_scope" }]
        },
        "operator": { "enum": ["gt", "lt"] },
        "threshold": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "aggregation": { "enum": ["interval_mean", "interval_rate", "interval_max", "interval_min"] },
        "min_consecutive_cells": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "effect": { "enum": ["diagnostic", "sla"] },
        "window_ids": { "$ref": "#/$defs/window_ids" },
        "max_missing_fraction": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "max_gap_cells": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "missing_transaction": { "enum": ["no_verdict", "warn"] }
      }
    },
    "service_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "services"],
      "properties": {
        "kind": { "const": "service" },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "all_services_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "all_services" },
        "except": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "overall_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "overall"
        }
      }
    },
    "transaction_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "const": "transaction"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
