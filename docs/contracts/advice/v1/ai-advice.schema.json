{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/schemas/advice/v1/ai-advice.schema.json",
  "title": "LT Verdict ai-advice.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "advisory", "run_id", "analysis_id", "analysis_manifest_sha256", "evidence_input_sha256", "output", "provenance"],
  "properties": {
    "schema_version": { "const": "ai-advice.v1" },
    "advisory": { "const": true },
    "run_id": { "type": "string", "minLength": 1 },
    "analysis_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analysis_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output": { "$ref": "ai-advice-output.schema.json" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "runner_id", "runner_version", "runner_artifact_sha256", "model_id", "prompt_version", "prompt_sha256", "duration_ms", "exit_code", "validation"],
      "properties": {
        "invocation_id": { "type": "string", "format": "uuid" },
        "runner_id": { "const": "gigacode-qwen-code" },
        "runner_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$",
          "description": "Version the CLI reported. The container runner is pinned to 0.21.1 (see allOf); the direct runner takes the operator's CLI (ADR 0027)."
        },
        "runner_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the CLI entry file. The container runner is pinned to the Qwen Code 0.21.1 hash (see allOf); the direct runner uses the operator's pin (ADR 0027)."
        },
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "not": { "pattern": "\\.\\.|//" },
          "description": "Observed model slug. The set of models is defined by the operator (ADR 0023), so it is checked by the slug pattern of ai-models.v1, not against a closed list."
        },
        "prompt_version": {
          "enum": ["advisory-system.v1", "advisory-system.v2"],
          "description": "Prompt label (ADR 0021, D1). The v1 label covers several editions of its file; the v2 label is bound to one pinned file hash that the reader checks."
        },
        "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 613000 },
        "exit_code": { "const": 0 },
        "validation": { "const": "PASSED" },
        "endpoint_host": {
          "type": "string",
          "maxLength": 260,
          "anyOf": [
            {
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?){0,126}|\\[(?=[0-9a-f:.]*:[0-9a-f:.]*:)(?=[0-9a-f:.]*[0-9a-f])[0-9a-f:.]{2,45}\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
            },
            { "const": "cli-builtin" }
          ],
          "description": "Host and port the relay actually sent the evidence to, lower case, always with the port, without scheme, path or credentials (ADR 0023, D4). Observed by the relay, not taken from the configuration. The value cli-builtin marks the direct runner, which has no relay: the CLI reached the model through its own channel, so no host is observed (ADR 0027)."
        },
        "provider_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Requests the relay forwarded to the provider for this advice: 1, or 2 after the one schema retry (ADR 0021, D2, D4). Absent in advice saved before it existed, which means 1. Absent and not countable in advice of the direct runner (ADR 0027)."
        }
      },
      "allOf": [
        {
          "if": { "required": ["endpoint_host"], "properties": { "endpoint_host": { "const": "cli-builtin" } } },
          "then": { "not": { "required": ["provider_requests"] } },
          "else": {
            "properties": {
              "runner_version": { "const": "0.21.1" },
              "runner_artifact_sha256": { "const": "1db9709bf1753611ca2fec234cf5adf517376efeb1540fcf9e309da010f9ed38" }
            }
          }
        },
        {
          "if": { "properties": { "prompt_version": { "const": "advisory-system.v2" } }, "required": ["prompt_version"] },
          "then": { "required": ["provider_requests"] }
        },
        {
          "if": { "required": ["endpoint_host"] },
          "else": {
            "properties": {
              "model_id": { "const": "deepseek-v4-flash-0731" },
              "prompt_version": { "const": "advisory-system.v1" }
            },
            "description": "Advice saved before endpoint_host existed: only the built-in ModelStudio endpoint and its model were possible."
          }
        }
      ]
    }
  }
}
