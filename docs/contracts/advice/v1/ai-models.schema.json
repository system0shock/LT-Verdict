{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/schemas/advice/v1/ai-models.schema.json",
  "title": "LT Verdict ai-models.v1",
  "description": "Model configuration file named by LT_VERDICT_AI_MODELS_FILE (ADR 0023). The file holds no secrets: the credential stays in LT_VERDICT_AI_CREDENTIAL_ENV_FILE. The schema cannot express: duplicate property names, unique model ids, default_model being one of the ids, a port above 65535, the host rules of java.net.URI or unassigned code points in labels. The loader enforces these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_model", "models"],
  "properties": {
    "schema_version": { "const": "ai-models.v1" },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "description": "Chat completions address: printable ASCII without quotes, backslash, backtick, ^ | < > { }, no userinfo, query or fragment, at most 512 characters. http requires allow_insecure_http true.",
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?=[\\x21-\\x7E]+$)(?=[^\"\\\\`^|<>{}]+$)https?://(\\[[0-9A-Fa-f:.]+\\]|[^/?#@:\\[\\]]+)(:[0-9]{1,5})?(/[^?#]*)?$"
        },
        "label": { "$ref": "#/$defs/label" },
        "allow_insecure_http": { "type": "boolean" }
      },
      "if": { "properties": { "url": { "pattern": "^http:" } }, "required": ["url"] },
      "then": { "required": ["allow_insecure_http"], "properties": { "allow_insecure_http": { "const": true } } }
    },
    "default_model": { "$ref": "#/$defs/slug" },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "$ref": "#/$defs/label" }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "not": { "pattern": "\\.\\.|//" }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "allOf": [
        { "pattern": "\\S" },
        { "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\p{Cs}]+$" }
      ]
    }
  },
  "examples": [
    {
      "schema_version": "ai-models.v1",
      "default_model": "deepseek-v4-flash-0731",
      "models": [{ "id": "deepseek-v4-flash-0731", "label": "DeepSeek V4 Flash" }]
    }
  ]
}
