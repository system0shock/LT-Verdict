{
  "schema_version": "policy.v1",
  "policy_id": "stages-platform",
  "defaults": { "sample_floor": 1, "min_samples": 1 },
  "rules": [
    { "id": "p95", "metric": "response_time_p95_ms", "operator": "lte", "threshold": 250, "scope": { "kind": "overall" } }
  ],
  "platform_services": ["orders"],
  "platform_coverage": { "signal": "openshift_unavailable_replicas" },
  "platform_rules": [
    {
      "id": "cpu",
      "signal": "openshift_container_cpu_limit_ratio",
      "scope": { "kind": "all_services" },
      "operator": "gt",
      "threshold": 0.4,
      "unit": "ratio",
      "aggregation": "interval_mean",
      "min_consecutive_cells": 2,
      "effect": "sla"
    },
    {
      "id": "cover",
      "signal": "openshift_unavailable_replicas",
      "scope": { "kind": "all_services" },
      "operator": "gt",
      "threshold": 0,
      "unit": "count",
      "aggregation": "interval_max",
      "min_consecutive_cells": 1,
      "effect": "sla"
    }
  ]
}
