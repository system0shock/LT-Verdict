{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/contracts/sources/probe/v1/doctor-report.schema.json",
  "title": "LT Verdict doctor report v1",
  "description": "Combined offline and optional online diagnostic report of saved source profiles (ADR 0033, ltv doctor). Offline by default (`online: false`). Codes only: no address, no environment variable name, no file path, no response body, no exception text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "online",
    "connections",
    "profiles",
    "summary",
    "resource_side"
  ],
  "properties": {
    "schema_version": {
      "const": "doctor-report.v1"
    },
    "online": {
      "type": "boolean"
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "profile_count"
      ],
      "properties": {
        "status": {
          "const": "OK"
        },
        "profile_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "source_kind",
          "transport",
          "arm",
          "query_count",
          "rule_count",
          "checks",
          "resource_side"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_kind": {
            "enum": [
              "prometheus",
              "victoria_metrics",
              "influxdb",
              "opensearch",
              "postgresql"
            ]
          },
          "transport": {
            "enum": [
              "direct",
              "grafana_proxy",
              null
            ]
          },
          "arm": {
            "type": [
              "string",
              "null"
            ]
          },
          "query_count": {
            "type": "integer",
            "minimum": 0
          },
          "rule_count": {
            "type": "integer",
            "minimum": 0
          },
          "checks": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status",
                "code"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "config",
                    "url",
                    "credentials",
                    "tls",
                    "rules",
                    "governor"
                  ]
                },
                "status": {
                  "enum": [
                    "OK",
                    "WARN",
                    "FAIL",
                    "SKIPPED"
                  ]
                },
                "code": {
                  "enum": [
                    "SOURCE_PROFILE_INVALID",
                    "SOURCE_AUTH_UNAVAILABLE",
                    "SOURCE_AUTH_INVALID",
                    "SOURCE_TLS_CONFIG_INVALID",
                    "SOURCE_TLS_HANDSHAKE_FAILED",
                    "SOURCE_TLS_CLIENT_CERT_EXPIRED",
                    "GOVERNOR_STRICT",
                    null
                  ]
                },
                "auth_kind": {
                  "enum": [
                    "none",
                    "bearer",
                    "token",
                    "basic"
                  ]
                }
              }
            }
          },
          "resource_side": {
            "enum": [
              "NOT_PROBED",
              "READY",
              "DEGRADED",
              "UNAVAILABLE"
            ]
          },
          "online": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "queries"
            ],
            "properties": {
              "queries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "query_id",
                    "status",
                    "code",
                    "http_status",
                    "series_count",
                    "observed_cells",
                    "expected_cells",
                    "decoder_check"
                  ],
                  "properties": {
                    "query_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "status": {
                      "enum": [
                        "OK",
                        "WARN",
                        "FAIL",
                        "SKIPPED"
                      ]
                    },
                    "code": {
                      "enum": [
                        "SOURCE_PROFILE_NOT_CONFIGURED",
                        "SOURCE_AUTH_UNAVAILABLE",
                        "SOURCE_AUTH_INVALID",
                        "SOURCE_HTTP_AUTH",
                        "SOURCE_HTTP_429",
                        "SOURCE_HTTP_5XX",
                        "SOURCE_HTTP_STATUS",
                        "SOURCE_HTTP_ERROR",
                        "SOURCE_TIMEOUT",
                        "SOURCE_RESPONSE_TOO_LARGE",
                        "SOURCE_TLS_CONFIG_INVALID",
                        "SOURCE_TLS_HANDSHAKE_FAILED",
                        "SOURCE_TLS_CLIENT_CERT_EXPIRED",
                        "SOURCE_CANCELLED",
                        "SOURCE_REQUEST_CAP_EXCEEDED",
                        "EMPTY_RESULT",
                        "MALFORMED_RESPONSE",
                        "PROMQL_QUERY_FAILED",
                        "INFLUXQL_QUERY_FAILED",
                        "SOURCE_WARNINGS",
                        "SOURCE_PARTIAL_RESPONSE",
                        "UNSUPPORTED_RESULT_TYPE",
                        "UNSUPPORTED_HISTOGRAM",
                        "AMBIGUOUS_SERIES",
                        "AMBIGUOUS_STATEMENT",
                        "LABEL_MISMATCH",
                        "OFF_GRID_TIMESTAMP",
                        "DUPLICATE_TIMESTAMP",
                        "RESOURCE_LIMIT_EXCEEDED",
                        "DUPLICATE_OBJECT_KEY",
                        null
                      ]
                    },
                    "http_status": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 100,
                      "maximum": 599
                    },
                    "series_count": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "observed_cells": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "expected_cells": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1,
                      "maximum": 240
                    },
                    "decoder_check": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "required": [
                        "accepted",
                        "code"
                      ],
                      "properties": {
                        "accepted": {
                          "type": "boolean"
                        },
                        "code": {
                          "enum": [
                            "EMPTY_RESULT",
                            "MALFORMED_RESPONSE",
                            "PROMQL_QUERY_FAILED",
                            "INFLUXQL_QUERY_FAILED",
                            "SOURCE_WARNINGS",
                            "SOURCE_PARTIAL_RESPONSE",
                            "UNSUPPORTED_RESULT_TYPE",
                            "UNSUPPORTED_HISTOGRAM",
                            "AMBIGUOUS_SERIES",
                            "AMBIGUOUS_STATEMENT",
                            "LABEL_MISMATCH",
                            "OFF_GRID_TIMESTAMP",
                            "DUPLICATE_TIMESTAMP",
                            "RESOURCE_LIMIT_EXCEEDED",
                            "DUPLICATE_OBJECT_KEY",
                            null
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "warn",
        "fail",
        "skipped"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resource_side": {
      "enum": [
        "NOT_PROBED",
        "READY",
        "DEGRADED",
        "UNAVAILABLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "online"
        ],
        "properties": {
          "online": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "resource_side": {
            "enum": [
              "NOT_PROBED",
              "UNAVAILABLE"
            ]
          }
        }
      }
    }
  ]
}
