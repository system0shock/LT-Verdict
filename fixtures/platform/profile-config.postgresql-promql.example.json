{
  "preset": "postgres-exporter",
  "profile_prefix": "pg-promql",
  "base_url": "http://127.0.0.1:9090",
  "targets": [
    {
      "instance": "pg-main:9187",
      "database": "loadtest",
      "entity": "load-test-db"
    }
  ],
  "signals": [
    "pg_connections_utilization",
    "pg_idle_in_transaction",
    "pg_cache_hit_ratio",
    "pg_xact_commit_rate",
    "pg_xact_rollback_rate",
    "pg_deadlocks_rate",
    "pg_temp_bytes_rate"
  ],
  "subquery_step": "15s",
  "peak_aggregation": true,
  "scrape_interval_ms": 30000,
  "request_step_ms": 60000
}
