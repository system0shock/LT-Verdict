{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/contracts/capacity/v1/capacity-plan.schema.json",
  "title": "LT Verdict capacity plan v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "load_input_sha256", "resource_snapshot_sha256", "load_axis", "achieved_load", "generator_guard_rule_ids", "stages"],
  "properties": {
    "schema_version": {"const":"capacity-plan.v1"}, "load_input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}, "resource_snapshot_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "load_axis":{"enum":["rps","concurrency","users"]}, "achieved_load":{"$ref":"#/$defs/achieved"}, "generator_guard_rule_ids":{"type":"array","maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "stages":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/stage"}}
  },
  "allOf": [
    {"if":{"properties":{"load_axis":{"const":"rps"}}},"then":{"properties":{"achieved_load":{"not":{"required":["achieved_series_id"]}}}}},
    {"if":{"properties":{"load_axis":{"enum":["concurrency","users"]}}},"then":{"properties":{"achieved_load":{"required":["achieved_series_id"]}}}}
  ],
  "$defs": {"id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[^\\u0000-\\u001F\\u007F-\\u009F]+$","description":"Runtime additionally enforces 128 UTF-8 bytes."},"achieved":{"type":"object","additionalProperties":false,"required":["statistic","target_tolerance_ratio"],"properties":{"statistic":{"const":"p05_10s"},"target_tolerance_ratio":{"type":"number","minimum":0,"exclusiveMaximum":1,"description":"Runtime additionally enforces token, precision, fractional-digit and exponent limits."},"required_capacity":{"type":"number","exclusiveMinimum":0,"maximum":1000000000000000000,"description":"Runtime additionally enforces token, precision, fractional-digit and exponent limits."},"achieved_series_id":{"$ref":"#/$defs/id"}}},"stage":{"type":"object","additionalProperties":false,"required":["id","target","from_epoch_ms","to_epoch_ms","evaluation_window_id"],"properties":{"id":{"$ref":"#/$defs/id"},"target":{"type":"number","exclusiveMinimum":0,"maximum":1000000000000000000,"description":"Runtime additionally enforces token, precision, fractional-digit and exponent limits."},"from_epoch_ms":{"type":"integer","minimum":0,"maximum":253402300799999},"to_epoch_ms":{"type":"integer","minimum":0,"maximum":253402300799999},"evaluation_window_id":{"$ref":"#/$defs/id"}}}}
}
