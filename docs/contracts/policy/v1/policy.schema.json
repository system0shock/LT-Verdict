{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LT Verdict policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "rules"],
  "properties": {
    "schema_version": {
      "const": "policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "operator", "threshold", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "metric": {
          "enum": [
            "response_time_p95_ms",
            "response_time_p99_ms",
            "error_rate_ratio",
            "throughput_rps"
          ]
        },
        "operator": {
          "enum": ["lte", "gte"]
        },
        "threshold": {
          "type": "number"
        },
        "scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/overall_scope"
            },
            {
              "$ref": "#/$defs/transaction_scope"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "metric": {
              "const": "response_time_p95_ms"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "response_time_p99_ms"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "error_rate_ratio"
            },
            "operator": {
              "const": "lte"
            },
            "threshold": {
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "properties": {
            "metric": {
              "const": "throughput_rps"
            },
            "operator": {
              "const": "gte"
            },
            "threshold": {
              "minimum": 0
            }
          }
        }
      ]
    },
    "overall_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "const": "overall"
        }
      }
    },
    "transaction_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "const": "transaction"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
