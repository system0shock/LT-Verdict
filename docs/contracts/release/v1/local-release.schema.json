{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/schemas/release/v1/local-release.schema.json",
  "title": "LT Verdict local-release.v1",
  "description": "Private release record stored as <data>/releases/<release_id>.json outside the immutable RunBundle (ADR 0019). It names saved analyses of one run and copies their verdict facts; it never holds metrics. This schema documents the on-disk form and is not a public API contract. The backend additionally enforces what JSON Schema cannot express: text limits in UTF-8 bytes (series, label and profile fields 128, notes 1024, coverage reasons 64), NFC-normalized text without control characters (notes may hold line feeds), release_id timestamp equal to started_at in milliseconds, distinct analysis_id values, one analysis without arm or several analyses with distinct arms, updated_at not before created_at, and the canonical byte form. Store limits (release count, analyses per record, record size) are constants of the store and are not part of the format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "series",
    "label",
    "run_id",
    "started_at",
    "analyses",
    "profile",
    "notes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "local-release.v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{15}-[0-9a-f]{8}$"
    },
    "series": {
      "$ref": "#/$defs/text"
    },
    "label": {
      "$ref": "#/$defs/text"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(jmeter_jtl_csv|jmeter_jtl_xml|gatling_text|gatling_binary)-[0-9a-f]{64}$"
    },
    "started_at": {
      "$ref": "#/$defs/instant"
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/analysis"
      }
    },
    "profile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/profile"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/instant"
    },
    "updated_at": {
      "$ref": "#/$defs/instant"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "arm",
        "coverage_reasons",
        "coverage_status",
        "policy_sha256",
        "policy_verdict",
        "run_validity"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arm": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "coverage_reasons": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "coverage_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|NO_POLICY)$"
        },
        "policy_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NO_POLICY",
            "NO_VERDICT"
          ]
        },
        "run_validity": {
          "enum": [
            "VALID",
            "DEGRADED",
            "INVALID"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_mix",
        "environment_dataset",
        "load_model",
        "targets_stages",
        "pacing",
        "generator_limits"
      ],
      "properties": {
        "scenario_mix": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "environment_dataset": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "load_model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "targets_stages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "pacing": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "generator_limits": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "scenario_mix": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "environment_dataset": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "load_model": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "targets_stages": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "pacing": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "generator_limits": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
