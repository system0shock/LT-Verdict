<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="child1" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">Thread.sleep(20)
SampleResult.setResponseData("child1-body", "UTF-8")
SampleResult.setLatency(5L)
SampleResult.setConnectTime(2L)
SampleResult.setSentBytes(10L)
</stringProp>
</JSR223Sampler>
