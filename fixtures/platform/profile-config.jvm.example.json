{
  "base_url": "http://127.0.0.1:9090",
  "profile_prefix": "jvm",
  "namespace": "shop",
  "services": ["orders-svc", "payments-svc"],
  "signals": [
    "jvm_heap_used",
    "jvm_old_gen_used",
    "jvm_non_heap_used",
    "jvm_thread_count",
    "jvm_process_cpu",
    "jvm_gc_pause",
    "jvm_gc_time",
    "jvm_pool_saturation"
  ],
  "subquery_step": "15s",
  "peak_aggregation": true,
  "scrape_interval_ms": 30000,
  "request_step_ms": 60000
}
