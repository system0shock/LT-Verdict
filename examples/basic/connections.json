{
  "schema_version": "source-connections.v1",
  "connections": [
    {
      "id": "catalog-prometheus",
      "source_kind": "prometheus",
      "transport": "direct",
      "base_url": "http://127.0.0.1:9090",
      "auth": {
        "type": "none"
      },
      "queries": [
        {
          "id": "cpu",
          "expression": "sum(rate(process_cpu_seconds_total{job=\"catalog\"}[$__interval]))",
          "metric": "process_cpu_usage",
          "unit": "cores",
          "entity": "catalog",
          "role": "system",
          "aggregation": "interval_rate",
          "labels": {
            "job": "catalog"
          }
        },
        {
          "id": "rss",
          "expression": "sum(avg_over_time(process_resident_memory_bytes{job=\"catalog\"}[$__interval]))",
          "metric": "process_resident_memory_bytes",
          "unit": "bytes",
          "entity": "catalog",
          "role": "system",
          "aggregation": "interval_mean",
          "labels": {
            "job": "catalog"
          }
        }
      ],
      "rules": [
        {
          "id": "cpu-high",
          "series_id": "cpu",
          "unit": "cores",
          "operator": "gt",
          "threshold": 0.8,
          "min_consecutive_cells": 2,
          "effect": "sla"
        },
        {
          "id": "rss-high",
          "series_id": "rss",
          "unit": "bytes",
          "operator": "gt",
          "threshold": 536870912,
          "min_consecutive_cells": 2,
          "effect": "sla"
        }
      ]
    }
  ]
}
