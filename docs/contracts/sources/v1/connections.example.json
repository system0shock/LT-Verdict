{
  "schema_version": "source-connections.v1",
  "connections": [{
    "id": "local-prometheus",
    "source_kind": "prometheus",
    "transport": "direct",
    "base_url": "http://127.0.0.1:9090",
    "auth": { "type": "none" },
    "queries": [{
      "id": "cpu", "expression": "avg_over_time(cpu_used_ratio{instance=\"host\"}[$__interval])",
      "metric": "cpu_used", "unit": "ratio", "entity": "host",
      "role": "system", "aggregation": "interval_mean", "labels": { "instance": "host" }
    }],
    "rules": [{
      "id": "cpu-high", "series_id": "cpu", "unit": "ratio", "operator": "gt",
      "threshold": 0.8, "min_consecutive_cells": 2, "effect": "sla"
    }]
  }]
}
