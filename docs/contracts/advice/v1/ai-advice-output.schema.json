{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-verdict.local/schemas/advice/v1/ai-advice-output.schema.json",
  "title": "LT Verdict ai-advice-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "hypotheses", "recommendations", "caveats"],
  "properties": {
    "schema_version": { "const": "ai-advice-output.v1" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "observation", "possible_explanation", "recommended_check", "evidence_refs"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
          "observation": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "possible_explanation": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "recommended_check": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "action", "rationale", "evidence_refs"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
          "action": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }
  }
}
